{
  "name": "malligai-kadai-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Local API for the Thanigai Stores desktop application",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:check": "tsx src/check-database.ts",
    "db:backup": "tsx src/backup-cli.ts backup",
    "db:restore": "tsx src/backup-cli.ts restore",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed-demo": "tsx src/demo-stock-data.ts",
    "admin:create": "tsx src/create-admin.ts",
    "test": "tsx --test src/*.test.ts",
    "test:db": "tsx --test src/product-database.test.ts",
    "test:billing-db": "tsx --test src/billing-database.test.ts",
    "test:reports-db": "tsx --test src/reports-database.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
